			"config": "cobblemonrizetweaks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"cobblemon": ">=1.5.2",
		"cloth-config": ">=11.1.118"
